import torch
import torch.nn as nn
import timm

class MultiTaskMobileNetV2(nn.Module):

    def __init__(self):
        super().__init__()

        # Shared MobileNetV2 feature extractor
        self.backbone = timm.create_model(
            "mobilenetv2_100",
            pretrained=True,
            num_classes=0
        )

        feature_dim = self.backbone.num_features

        # Disease-specific classification heads
        self.dr_head = nn.Linear(feature_dim, 5)
        self.glaucoma_head = nn.Linear(feature_dim, 2)
        self.dme_head = nn.Linear(feature_dim, 2)
        self.amd_head = nn.Linear(feature_dim, 2)
        self.hr_head = nn.Linear(feature_dim, 2)

    def forward(self, x):

        features = self.backbone(x)

        return {
            "dr": self.dr_head(features),
            "glaucoma": self.glaucoma_head(features),
            "dme": self.dme_head(features),
            "amd": self.amd_head(features),
            "hr": self.hr_head(features)
        }


# Model initialization
model = MultiTaskMobileNetV2()

print(model)
